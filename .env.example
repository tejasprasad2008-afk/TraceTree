# TraceTree Workbench provider configuration
#
# Copy this file to .env, or run `cascade-analyze setup`. The dashboard setup
# screen writes the same root .env file locally. Never commit your actual .env.

# Choose one: openai, claude, openrouter, ollama, mock
# Leave this as mock to use the dashboard without a cloud-provider API key.
LLM_PROVIDER=mock

# OpenAI (default base URL: https://api.openai.com/v1)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Anthropic (default base URL: https://api.anthropic.com)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=

# OpenRouter (default base URL: https://openrouter.ai/api/v1)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=

# Optional local-only model provider
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Optional: protect the local API when exposing it beyond loopback.
# TRACETREE_API_KEYS=
