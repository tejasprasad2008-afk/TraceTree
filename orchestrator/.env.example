# LLM Configuration
LLM_PROVIDER=claude # options: claude, openrouter, ollama
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=info # debug, info, warn, error

# MCP Configuration
# Add paths to local MCP server configs or remote URLs
MCP_CONFIG_PATH=./mcp-config.json
