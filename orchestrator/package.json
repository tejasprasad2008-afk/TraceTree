{
  "name": "tracetree",
  "version": "0.1.0",
  "description": "Open-source autonomous security detection and response platform",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tracetree": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "security",
    "soar",
