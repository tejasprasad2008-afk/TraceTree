# This image is intentionally separate from TraceTree's legacy sandbox.  It is
# for adaptive npm import/harness attempts only and must be built from a pinned
# Node image digest by the deployment pipeline.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends strace \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /input /out /work /opt/tracetree \
    && chown -R runner:runner /input /out /work /opt/tracetree

COPY adaptive_import_probe.mjs /opt/tracetree/adaptive_import_probe.mjs
RUN chmod 0555 /opt/tracetree/adaptive_import_probe.mjs

WORKDIR /work
USER 10001:10001
